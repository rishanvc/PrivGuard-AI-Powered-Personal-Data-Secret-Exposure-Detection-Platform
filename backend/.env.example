# PrivGuard backend configuration
# SRS 13.2 (environment configuration), NFR-016 (production secrets outside source control).
# Template only - PLACEHOLDER VALUES, no real secrets (SRS 13.2). Copy to .env and fill in.

# --- Django core ---
DJANGO_SECRET_KEY=replace-me-generate-with-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (FR: persistent storage, SRS 7) ---
DATABASE_URL=postgres://privguard:replace-me-with-your-local-db-password@localhost:5432/privguard

# --- Browser security (NFR-017) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Runtime storage (NFR-023: controlled locations) ---
# All mutable scan artifacts live under this root. Relative paths resolve
# against backend/. This whole tree is gitignored.
PRIVGUARD_VAR_ROOT=var

# --- Scan limits (FR-019, NFR-003, NFR-010) ---
MAX_UPLOAD_SIZE_MB=25
MAX_TOTAL_SCAN_SIZE_MB=200

# --- Retention (FR-110, FR-114) ---
SCAN_RETENTION_DAYS=30

# --- OCR, optional (FR-027, Cycle 8) ---
OCR_ENABLED=False
TESSERACT_CMD=

# --- Local AI, optional (FR-062, FR-069, Cycle 9) ---
# Core scanning MUST work with this disabled (FR-063, NFR-048).
AI_ENABLED=False
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Authentication & sessions (FR-001, FR-006, FR-007; Cycle 2) ---
ALLOW_REGISTRATION=False
SESSION_COOKIE_AGE_SECONDS=28800
AUTH_THROTTLE_RATE=5/min
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
